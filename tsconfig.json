{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "checkJs": true,
    "types": ["node", "next", "next/image-types/global"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2017",
    "skipLibCheck": false
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    "*.js",
    "*.mjs",
    "*.cjs",
    "src/**/*.js",
    ".next/types/**/*.ts",
    "src/locales/index.ts"
  ],
  "exclude": ["node_modules", "tools", "src-tauri", "out"]
}
