{
  "name": "folly-launcher",
  "version": "1.3.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "browserslist": [
    "Safari >= 14"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bun run check && next build --webpack",
    "start": "next start",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings . && eslint src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "check": "bun run format:check && bun run typecheck && bun run lint",
    "tauri": "tauri",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "version": "node scripts/version/index.js",
    "locale": "node scripts/locale/index.js",
    "brand": "node scripts/brand/apply.js"
  },
  "lint-staged": {
    "{src-tauri/src/**/*.rs,src-tauri/crates/**/*.rs,src-tauri/build.rs}": [
      "rustfmt --check"
    ],
    "src/locales/*.json": [
      "bun run locale diff en",
      "bun run locale diff zh-Hans"
    ]
  },
  "dependencies": {
    "@chakra-ui/react": ">=2.8.2 <3.0.0",
    "@chakra-ui/theme-tools": "^2.2.6",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "fuse.js": "^7.3.0",
    "i18next": "^24.0.0",
    "masonic": "^4.0.1",
    "next": "16.3.8",
    "react": "^18",
    "react-dom": "^18",
    "react-i18next": "^15.1.1",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-spinners": "^0.14.1",
    "react-virtualized": "^9.22.6",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-virtualized": "^9.22.0",
    "chalk": "^4.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "^1.65.0",
    "typescript": "^5"
  },
  "overrides": {
    "mdast-util-gfm-autolink-literal": "2.0.0",
    "@types/react": "18.3.31"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
